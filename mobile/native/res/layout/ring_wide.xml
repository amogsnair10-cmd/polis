<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg" android:padding="12dp">
<FrameLayout android:layout_width="100dp" android:layout_height="100dp">
<ProgressBar android:id="@+id/w_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="100" android:progress="3" android:indeterminate="false" android:progressDrawable="@drawable/ring_progress"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
<TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textSize="28sp" android:textColor="#F2C46D" android:textStyle="bold" android:fontFamily="serif" android:includeFontPadding="false"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAY STREAK" android:textSize="8sp" android:textColor="#8FA0BD" android:includeFontPadding="false" android:letterSpacing="0.06" android:layout_marginTop="2dp"/>
</LinearLayout>
</FrameLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="14dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical">
<TextView android:id="@+id/w_cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="9sp" android:textColor="#8FA0BD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:letterSpacing="0.1"/>
<TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14.5sp" android:textColor="#FFFFFF" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="3dp"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

</FrameLayout>
<TextView android:id="@+id/w_subsline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#FFFFFF" android:textStyle="bold" android:includeFontPadding="false" android:background="@drawable/w_chip" android:paddingTop="3dp" android:paddingBottom="3dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
</LinearLayout>
