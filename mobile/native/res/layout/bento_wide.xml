<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@drawable/widget_bg" android:padding="9dp">
<LinearLayout android:layout_width="92dp" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/w_tile" android:padding="6dp" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥" android:textSize="22sp" android:textColor="#FFFFFF" android:includeFontPadding="false"/>
<TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textSize="36sp" android:textColor="#F2C46D" android:textStyle="bold" android:fontFamily="serif" android:includeFontPadding="false"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAY STREAK" android:textSize="9sp" android:textColor="#8FA0BD" android:includeFontPadding="false" android:gravity="center" android:layout_marginTop="2dp" android:letterSpacing="0.1"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/w_tile" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:orientation="vertical">
<TextView android:id="@+id/w_cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="9sp" android:textColor="#8FA0BD" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:letterSpacing="0.1"/>
<TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14.5sp" android:textColor="#FFFFFF" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="3dp"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ProgressBar android:id="@+id/w_prog" android:style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="5dp" android:max="10" android:progress="0" android:progressDrawable="@drawable/widget_progress" android:layout_weight="1"/>
<TextView android:id="@+id/w_btn" android:layout_width="34dp" android:layout_height="34dp" android:text="→" android:textSize="17sp" android:textColor="#14213D" android:textStyle="bold" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/w_gold_circle" android:layout_marginStart="10dp"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
