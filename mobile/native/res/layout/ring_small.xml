<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:padding="8dp">
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:layout_gravity="center">
<FrameLayout android:layout_width="112dp" android:layout_height="112dp">
<ProgressBar android:id="@+id/w_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="100" android:progress="3" android:indeterminate="false" android:progressDrawable="@drawable/ring_progress"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
<TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textSize="30sp" android:textColor="#F2C46D" android:textStyle="bold" android:fontFamily="serif" android:includeFontPadding="false"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAY STREAK" android:textSize="8sp" android:textColor="#8FA0BD" android:includeFontPadding="false" android:letterSpacing="0.06" android:layout_marginTop="2dp"/>
</LinearLayout>
</FrameLayout>
</FrameLayout>
<ImageView android:id="@+id/w_lumen" android:layout_width="wrap_content" android:layout_height="28dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/lumen_neutral" android:layout_gravity="top|end" android:layout_margin="2dp" android:layout_marginBottom="0dp" android:layout_marginEnd="0dp"/>
</FrameLayout>
