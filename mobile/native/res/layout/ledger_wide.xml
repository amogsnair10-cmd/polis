<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_bg_light" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
<ImageView android:id="@+id/w_lumen" android:layout_width="wrap_content" android:layout_height="30dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/lumen_neutral" android:layout_marginEnd="8dp"/>
<TextView android:id="@+id/w_subject" android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:textColor="#1D2433" android:textStyle="bold" android:fontFamily="serif" android:includeFontPadding="false" android:layout_weight="1" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/w_pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 12" android:textSize="15sp" android:textColor="#9A6F1C" android:textStyle="bold" android:includeFontPadding="false"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2DAC8">

</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:gravity="center_vertical" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UP NEXT" android:textSize="9.5sp" android:textColor="#9A6F1C" android:textStyle="bold" android:includeFontPadding="false" android:letterSpacing="0.14"/>
<TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14.5sp" android:textColor="#1D2433" android:textStyle="bold" android:fontFamily="serif" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="3dp"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2DAC8">

</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
<TextView android:id="@+id/w_d0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="12sp" android:textColor="#CFC5AE" android:includeFontPadding="false" android:layout_marginEnd="5dp"/>
<TextView android:id="@+id/w_d1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="12sp" android:textColor="#CFC5AE" android:includeFontPadding="false" android:layout_marginEnd="5dp"/>
<TextView android:id="@+id/w_d2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="12sp" android:textColor="#CFC5AE" android:includeFontPadding="false" android:layout_marginEnd="5dp"/>
<TextView android:id="@+id/w_d3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="12sp" android:textColor="#CFC5AE" android:includeFontPadding="false" android:layout_marginEnd="5dp"/>
<TextView android:id="@+id/w_d4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="12sp" android:textColor="#CFC5AE" android:includeFontPadding="false" android:layout_marginEnd="5dp"/>
<TextView android:id="@+id/w_d5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="12sp" android:textColor="#CFC5AE" android:includeFontPadding="false" android:layout_marginEnd="5dp"/>
<TextView android:id="@+id/w_d6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="12sp" android:textColor="#CFC5AE" android:includeFontPadding="false" android:layout_marginEnd="5dp"/>
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1">

</FrameLayout>
<TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Continue →" android:textSize="13sp" android:textColor="#9A6F1C" android:textStyle="bold" android:includeFontPadding="false"/>
</LinearLayout>
</LinearLayout>
