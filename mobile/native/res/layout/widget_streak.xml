<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🔥 0" android:textColor="#F2C46D" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:id="@+id/w_subject" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Light Bulb" android:textColor="#B9C4D6" android:textSize="12sp" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Open to start today's lesson" android:textColor="#FFFFFF" android:textSize="15sp" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
